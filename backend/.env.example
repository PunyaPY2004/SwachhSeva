# Copy this file to ".env" in the same folder and fill in real values.
# NEVER commit the real ".env" file to GitHub.

# PostgreSQL connection string.
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://swachhseva_user:changeme@localhost:5432/swachhseva

# Any long random string. You can generate one in the Python terminal with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_this_with_a_long_random_string

# development | production
FLASK_ENV=development

# Folder (relative to backend/) where uploaded complaint photos are stored
UPLOAD_FOLDER=uploads

# Folder (relative to backend/) where resolution photos are stored
RESOLUTION_UPLOAD_FOLDER=uploads/resolutions

# Path to the trained Keras model file.
# If this file does not exist, the backend automatically runs in DEMO MODE
# and clearly labels every prediction as "demo_mode": true.
AI_MODEL_PATH=models/civic_classifier.keras

# Max upload size in megabytes
MAX_UPLOAD_MB=8
