{
  "expo": {
    "name": "SwachhSeva",
    "slug": "swachhseva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.swachhseva.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SwachhSeva needs access to your photos so you can attach a picture of the civic issue.",
          "cameraPermission": "SwachhSeva needs access to your camera so you can photograph the civic issue."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SwachhSeva needs your location to tag where the civic issue is, so officers know where to go."
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "27c77577-ad88-46f0-a052-676fe3ddb806"
      }
    }
  }
}
